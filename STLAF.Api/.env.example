ConnectionStrings__Default=Host=aws-0-xxxx.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.xxxxxxxx;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
Jwt__Secret=replace-with-a-long-random-string
Jwt__Issuer=STLAF.Api
Jwt__Audience=STLAF.Client
Jwt__ExpiresInMinutes=480
Supabase__Url=https://xxxxxxxx.supabase.co
Supabase__ServiceRoleKey=your-service-role-key